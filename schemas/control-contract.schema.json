{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eaa-rif:schema:control-contract:1.0.0",
  "title": "EAA-RIF Control Contract",
  "description": "ORIGINAL IP: a machine-readable contract linking a risk treatment objective to policy, enforcement, testing, evidence, failure behavior, ownership, and review.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_label",
    "control_id",
    "objective",
    "risk_ids",
    "source_requirement_ids",
    "system_scope",
    "impact_tier",
    "risk_tier",
    "agent_authority",
    "control_owner",
    "operator",
    "control_type",
    "execution_mode",
    "lifecycle_points",
    "enforcement_point_ids",
    "policy_ids",
    "trusted_inputs",
    "decision_logic",
    "expected_result",
    "test_cases",
    "evidence_contract",
    "failure_behavior",
    "exception",
    "version",
    "review_triggers"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "source_label": {
      "type": "string",
      "enum": ["SOURCE_FRAMEWORK", "DERIVED_MAPPING", "ORIGINAL_IP"]
    },
    "control_id": {
      "type": "string",
      "pattern": "^CTRL-[A-Z0-9_-]+$"
    },
    "objective": {
      "type": "string",
      "minLength": 20
    },
    "risk_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^RISK-[A-Z0-9_-]+$"
      }
    },
    "source_requirement_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^REQ-[A-Z0-9_-]+$"
      }
    },
    "system_scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^SYS-[A-Z0-9_-]+$"
      }
    },
    "impact_tier": {
      "description": "Consequence-severity input before the resulting governance classification is assigned.",
      "type": "string",
      "enum": ["low", "moderate", "high", "critical"]
    },
    "risk_tier": {
      "description": "Resulting governance classification after impact, exposure, uncertainty, context, controls, and agent authority are considered.",
      "type": "string",
      "enum": ["low", "moderate", "high", "critical"]
    },
    "agent_authority": {
      "description": "Canonical machine classification for the maximum approved agent action authority.",
      "type": "string",
      "enum": ["A0", "A1", "A2", "A3", "A4", "A5", "not_applicable"]
    },
    "control_owner": {
      "type": "string",
      "minLength": 2
    },
    "operator": {
      "type": "string",
      "minLength": 2
    },
    "control_type": {
      "type": "string",
      "enum": ["preventive", "detective", "corrective", "recovery"]
    },
    "execution_mode": {
      "type": "string",
      "enum": ["manual", "automated", "hybrid"]
    },
    "lifecycle_points": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["design", "build", "deploy", "runtime", "post_event"]
      }
    },
    "enforcement_point_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^EP-[A-Z0-9_-]+$"
      }
    },
    "policy_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^POL-[A-Z0-9_-]+$"
      }
    },
    "trusted_inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "schema",
          "authoritative_source",
          "freshness",
          "classification",
          "sensitive"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2
          },
          "schema": {
            "type": "string",
            "minLength": 2
          },
          "authoritative_source": {
            "type": "string",
            "minLength": 2
          },
          "freshness": {
            "type": "string",
            "minLength": 2
          },
          "classification": {
            "type": "string",
            "enum": ["public", "internal", "confidential", "restricted"]
          },
          "sensitive": {
            "type": "boolean"
          }
        }
      }
    },
    "decision_logic": {
      "type": "string",
      "minLength": 10
    },
    "parameters": {
      "type": "object"
    },
    "expected_result": {
      "type": "string",
      "minLength": 10
    },
    "test_cases": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["test_id", "class", "expected"],
        "properties": {
          "test_id": {
            "type": "string",
            "pattern": "^TEST-[A-Z0-9_-]+$"
          },
          "class": {
            "type": "string",
            "enum": [
              "allow",
              "deny",
              "boundary",
              "missing_input",
              "stale",
              "replay",
              "outage",
              "bypass",
              "recovery"
            ]
          },
          "expected": {
            "type": "string",
            "minLength": 5
          }
        }
      }
    },
    "evidence_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_schema",
        "producer",
        "frequency",
        "freshness_limit",
        "retention_classification",
        "required_fields"
      ],
      "properties": {
        "record_schema": {
          "type": "string",
          "minLength": 3
        },
        "producer": {
          "type": "string",
          "minLength": 2
        },
        "frequency": {
          "type": "string",
          "minLength": 2
        },
        "freshness_limit": {
          "type": "string",
          "minLength": 2
        },
        "retention_classification": {
          "type": "string",
          "minLength": 2
        },
        "required_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "failure_behavior": {
      "type": "string",
      "enum": [
        "fail_closed",
        "fail_safe_read_only",
        "degrade_and_escalate",
        "retry_with_bound",
        "stop"
      ]
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "required_compensating_controls"],
      "properties": {
        "allowed": {
          "type": "boolean"
        },
        "maximum_duration": {
          "type": "string"
        },
        "required_compensating_controls": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "effective_date": {
      "type": "string",
      "format": "date"
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approver", "approved_on", "signature_ref"],
      "properties": {
        "approver": {
          "type": "string",
          "minLength": 2
        },
        "approved_on": {
          "type": "string",
          "format": "date-time"
        },
        "signature_ref": {
          "type": "string",
          "minLength": 3
        }
      }
    },
    "review_triggers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 2
      }
    }
  }
}
