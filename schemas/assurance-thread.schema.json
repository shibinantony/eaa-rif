{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eaa-rif:schema:assurance-thread:1.0.0",
  "title": "EAA-RIF Architecture-to-Evidence Assurance Thread",
  "description": "ORIGINAL IP: a normalized traceability-graph snapshot for a governed AI system and a configuration-bound authorization decision.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_label",
    "thread_id",
    "generated_at",
    "system",
    "source_baselines",
    "nodes",
    "edges",
    "authorization"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "source_label": {
      "type": "string",
      "enum": ["SOURCE_FRAMEWORK", "DERIVED_MAPPING", "ORIGINAL_IP"]
    },
    "thread_id": {
      "type": "string",
      "pattern": "^THREAD-[A-Z0-9_-]+$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "eaa_rif_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system_id",
        "name",
        "business_owner",
        "product_owner",
        "impact_tier",
        "risk_tier",
        "agent_authority",
        "lifecycle_state",
        "configuration_digest"
      ],
      "properties": {
        "system_id": {
          "type": "string",
          "pattern": "^SYS-[A-Z0-9_-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 3
        },
        "business_owner": {
          "type": "string",
          "minLength": 2
        },
        "product_owner": {
          "type": "string",
          "minLength": 2
        },
        "impact_tier": {
          "description": "Consequence-severity input before the resulting governance classification is assigned.",
          "type": "string",
          "enum": ["low", "moderate", "high", "critical"]
        },
        "risk_tier": {
          "description": "Resulting governance classification after impact, exposure, uncertainty, context, controls, and agent authority are considered.",
          "type": "string",
          "enum": ["low", "moderate", "high", "critical"]
        },
        "agent_authority": {
          "description": "Canonical machine classification for the maximum approved agent action authority.",
          "type": "string",
          "enum": ["A0", "A1", "A2", "A3", "A4", "A5", "not_applicable"]
        },
        "lifecycle_state": {
          "type": "string",
          "enum": [
            "proposed",
            "sandbox",
            "development",
            "validation",
            "restricted_pilot",
            "production",
            "suspended",
            "retired"
          ]
        },
        "configuration_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "source_baselines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "url", "accessed_on"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "accessed_on": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "title", "owner", "status", "version", "attributes"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_-]+$"
          },
          "type": {
            "type": "string",
            "enum": [
              "business_objective",
              "architecture_principle",
              "architecture_decision",
              "risk",
              "requirement",
              "control",
              "policy",
              "enforcement_point",
              "evidence",
              "exception",
              "gate_decision",
              "actor"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 3
          },
          "owner": {
            "type": "string",
            "minLength": 2
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "active",
              "approved",
              "degraded",
              "failed",
              "expired",
              "superseded",
              "retired"
            ]
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "attributes": {
            "type": "object"
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "relationship", "to"],
        "properties": {
          "from": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_-]+$"
          },
          "relationship": {
            "type": "string",
            "enum": [
              "motivates",
              "constrains",
              "decides",
              "creates_risk",
              "maps_to",
              "requires",
              "treats",
              "implemented_by",
              "enforced_at",
              "produces_evidence",
              "supports_decision",
              "accepts",
              "excepts",
              "triggers_reassessment"
            ]
          },
          "to": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_-]+$"
          }
        }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_decision_id",
        "decision",
        "authority",
        "scope",
        "configuration_digest",
        "decided_at",
        "expires_at",
        "conditions",
        "evidence_ids",
        "residual_risk"
      ],
      "properties": {
        "gate_decision_id": {
          "type": "string",
          "pattern": "^GATE-[A-Z0-9_-]+$"
        },
        "decision": {
          "type": "string",
          "enum": [
            "not_authorized",
            "restricted_pilot",
            "authorized",
            "authorized_with_conditions",
            "suspended",
            "retired"
          ]
        },
        "authority": {
          "type": "string",
          "minLength": 2
        },
        "scope": {
          "type": "string",
          "minLength": 3
        },
        "configuration_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "decided_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^EVID-[A-Z0-9_-]+$"
          }
        },
        "residual_risk": {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision", "owner", "decided_at"],
          "properties": {
            "decision": {
              "type": "string",
              "enum": ["accepted", "accepted_with_conditions", "not_accepted"]
            },
            "owner": {
              "type": "string",
              "minLength": 2
            },
            "decided_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      }
    }
  }
}
