{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eaa-rif:schema:evidence-record:1.0.0",
  "title": "EAA-RIF Control Evidence Record",
  "description": "ORIGINAL IP: a provenance-preserving evidence record for a control, evaluation, policy decision, or assurance assertion.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_label",
    "evidence_id",
    "control_id",
    "system_id",
    "configuration_digest",
    "producer",
    "collected_at",
    "environment",
    "claim",
    "expected_result",
    "actual_result",
    "state",
    "raw_evidence_ref",
    "integrity",
    "trace_id",
    "classification",
    "quality",
    "validity"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "source_label": {
      "type": "string",
      "enum": ["SOURCE_FRAMEWORK", "DERIVED_MAPPING", "ORIGINAL_IP"]
    },
    "evidence_id": {
      "type": "string",
      "pattern": "^EVID-[A-Z0-9_-]+$"
    },
    "control_id": {
      "type": "string",
      "pattern": "^CTRL-[A-Z0-9_-]+$"
    },
    "policy_id": {
      "type": "string",
      "pattern": "^POL-[A-Z0-9_-]+$"
    },
    "enforcement_point_id": {
      "type": "string",
      "pattern": "^EP-[A-Z0-9_-]+$"
    },
    "gate_decision_id": {
      "type": "string",
      "pattern": "^GATE-[A-Z0-9_-]+$"
    },
    "system_id": {
      "type": "string",
      "pattern": "^SYS-[A-Z0-9_-]+$"
    },
    "configuration_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "producer": {
      "type": "string",
      "minLength": 2
    },
    "collector": {
      "type": "string",
      "minLength": 2
    },
    "reviewer": {
      "type": "string",
      "minLength": 2
    },
    "collected_at": {
      "type": "string",
      "format": "date-time"
    },
    "observation_window": {
      "type": "string"
    },
    "environment": {
      "type": "string",
      "enum": ["sandbox", "development", "test", "staging", "production"]
    },
    "scope": {
      "type": "string"
    },
    "population": {
      "type": "string"
    },
    "sample": {
      "type": "string"
    },
    "claim": {
      "type": "string",
      "minLength": 10
    },
    "expected_result": {
      "type": "string",
      "minLength": 5
    },
    "actual_result": {
      "type": "string",
      "minLength": 5
    },
    "state": {
      "type": "string",
      "enum": ["pass", "fail", "degraded", "inconclusive", "not_run"]
    },
    "raw_evidence_ref": {
      "type": "string",
      "minLength": 3
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hash_algorithm", "hash"],
      "properties": {
        "hash_algorithm": {
          "type": "string",
          "enum": ["sha256", "sha384", "sha512"]
        },
        "hash": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{64}|[a-f0-9]{96}|[a-f0-9]{128})$"
        },
        "signature_ref": {
          "type": "string",
          "minLength": 3
        },
        "attestation_ref": {
          "type": "string",
          "minLength": 3
        }
      }
    },
    "trace_id": {
      "type": "string",
      "minLength": 8
    },
    "related_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "classification": {
      "type": "string",
      "enum": ["public", "internal", "confidential", "restricted"]
    },
    "retention": {
      "type": "string"
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provenance",
        "integrity",
        "freshness",
        "coverage",
        "independence",
        "limitations"
      ],
      "properties": {
        "provenance": {
          "type": "string",
          "enum": ["low", "moderate", "high"]
        },
        "integrity": {
          "type": "string",
          "enum": ["low", "moderate", "high"]
        },
        "freshness": {
          "type": "string",
          "enum": ["low", "moderate", "high"]
        },
        "coverage": {
          "type": "string",
          "enum": ["low", "moderate", "high"]
        },
        "representativeness": {
          "type": "string",
          "enum": ["low", "moderate", "high"]
        },
        "independence": {
          "type": "string",
          "enum": ["low", "moderate", "high"]
        },
        "interpretability": {
          "type": "string",
          "enum": ["low", "moderate", "high"]
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valid_for", "expires_at", "invalidation_triggers"],
      "properties": {
        "valid_for": {
          "type": "string",
          "minLength": 3
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "invalidation_triggers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2
          }
        }
      }
    }
  }
}
